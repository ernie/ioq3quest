		text "SP 6DoF Movement:"
		cvar "vr_6dof"
		rect 99 140 256 20
      		textalign ITEM_ALIGN_RIGHT
      		textalignx 128
      		textaligny 20
		textscale .333
      		forecolor 1 1 1 1
      		visible 1
		mouseEnter { show message_sixdof }
		mouseExit { hide message_sixdof }
    		}

	itemDef {
		name message_sixdof
		text "Physical head movement controls in-game movement (SP only)"
